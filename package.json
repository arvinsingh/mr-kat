{
  "name": "mr-kat",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Discord moderation and community bot",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "commands": "node --env-file-if-exists=.env dist/src/register.js",
    "check": "tsc --noEmit",
    "backup": "node --env-file-if-exists=.env dist/src/backup.js",
    "docs": "node --import tsx scripts/generate-docs.ts",
    "format": "prettier --write .github src scripts docs *.md index.js start.mjs package.json tsconfig*.json",
    "format:check": "prettier --check .github src scripts docs *.md index.js start.mjs package.json tsconfig*.json",
    "recover": "node --env-file-if-exists=.env dist/src/recover.js"
  },
  "dependencies": {
    "discord.js": "14.28.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "author": "arvinsingh",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvinsingh/mr-kat.git"
  }
}
